{
  "name": "loci",
  "version": "1.1.0",
  "private": true,
  "description": "Loci monorepo workspace.",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "pretest": "pnpm --filter @loci/core build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @loci/core typecheck && pnpm --filter @loci/desktop typecheck && pnpm --filter @loci/server typecheck",
    "desktop:typecheck": "pnpm --filter @loci/desktop typecheck",
    "server:build": "pnpm --filter @loci/core build && pnpm --filter @loci/server build",
    "server:start": "pnpm --filter @loci/server start",
    "server:test": "pnpm --filter @loci/server test",
    "server:typecheck": "pnpm --filter @loci/server typecheck",
    "start": "pnpm --filter @loci/desktop start",
    "dev": "pnpm --filter @loci/desktop dev",
    "build": "pnpm --filter @loci/desktop build",
    "build:unpack": "pnpm --filter @loci/desktop build:unpack",
    "build:win": "pnpm --filter @loci/desktop build:win",
    "build:mac": "pnpm --filter @loci/desktop build:mac",
    "build:linux": "pnpm --filter @loci/desktop build:linux",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
