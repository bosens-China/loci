{
  "name": "loci",
  "version": "1.2.1",
  "private": true,
  "description": "Local-first documentation knowledge base for AI agents.",
  "author": "yliu",
  "license": "MIT",
  "homepage": "https://bosens-china.github.io/loci/",
  "bugs": {
    "url": "https://github.com/bosens-China/loci/issues"
  },
  "keywords": [
    "ai-agents",
    "documentation",
    "knowledge-base",
    "local-first",
    "mcp",
    "model-context-protocol",
    "openapi",
    "web-crawling"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/loci.git"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "check:release-versions": "node --experimental-strip-types scripts/check-release-versions.mts",
    "test": "vitest run scripts/test && pnpm --filter @loci/core test && pnpm --filter @loci/shared test && pnpm --filter @loci/runtime test && pnpm --filter @boses/cli test && pnpm --filter @loci/server test && pnpm --filter @loci/web test",
    "test:watch": "pnpm --parallel --filter @loci/core --filter @loci/shared --filter @boses/cli --filter @loci/server --filter @loci/web test:watch",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json && pnpm -r typecheck",
    "cli:build": "pnpm --filter @boses/cli build",
    "cli:test": "pnpm --filter @boses/cli test",
    "web:build": "pnpm --filter @loci/web build",
    "web:test": "pnpm --filter @loci/web test",
    "docs:dev": "pnpm --filter @loci/docs dev",
    "docs:build": "pnpm --filter @loci/docs build",
    "server:build": "pnpm --filter @loci/server build",
    "server:start": "pnpm --filter @loci/server start",
    "server:test": "pnpm --filter @loci/server test",
    "server:typecheck": "pnpm --filter @loci/server typecheck",
    "start": "pnpm dev",
    "dev": "tsx scripts/dev-web.mts",
    "build": "pnpm cli:build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.65.0",
    "typescript": "^5.9.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
