{
  "name": "loci",
  "version": "1.2.1",
  "private": true,
  "description": "Loci monorepo workspace.",
  "author": "yliu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/loci.git"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "check:release-versions": "node --experimental-strip-types scripts/check-release-versions.mts",
    "test": "vitest run scripts/test/check-release-versions.test.ts && pnpm --filter @loci/core test && pnpm --filter @loci/shared test && pnpm --filter @loci/runtime test && pnpm --filter @boses/cli test && pnpm --filter @loci/server test && pnpm --filter @loci/desktop test",
    "test:watch": "pnpm --parallel --filter @loci/core --filter @loci/shared --filter @boses/cli --filter @loci/server --filter @loci/desktop test:watch",
    "typecheck": "pnpm --filter @loci/core typecheck && pnpm --filter @loci/shared typecheck && pnpm --filter @loci/runtime typecheck && pnpm --filter @loci/desktop typecheck && pnpm --filter @loci/server typecheck && pnpm --filter @boses/cli typecheck",
    "cli:build": "pnpm --filter @boses/cli build",
    "cli:test": "pnpm --filter @boses/cli test",
    "docs:dev": "pnpm --filter @loci/docs dev",
    "docs:build": "pnpm --filter @loci/docs build",
    "desktop:typecheck": "pnpm --filter @loci/desktop typecheck",
    "server:build": "pnpm --filter @loci/server build",
    "server:start": "pnpm --filter @loci/server start",
    "server:test": "pnpm --filter @loci/server test",
    "server:typecheck": "pnpm --filter @loci/server typecheck",
    "start": "pnpm --filter @loci/desktop start",
    "dev": "pnpm --filter @loci/desktop dev",
    "build": "pnpm --filter @loci/desktop build",
    "build:unpack": "pnpm --filter @loci/desktop build:unpack",
    "build:win": "pnpm --filter @loci/desktop build:win",
    "build:mac": "pnpm --filter @loci/desktop build:mac",
    "build:linux": "pnpm --filter @loci/desktop build:linux",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
