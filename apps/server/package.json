{
  "name": "@loci/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretest": "pnpm --filter @loci/core build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @loci/core build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@loci/core": "workspace:*",
    "croner": "^10.0.1",
    "hono": "^4.10.8",
    "playwright-core": "1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
