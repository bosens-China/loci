{
  "name": "@loci/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Loci desktop application.",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "pnpm --filter @loci/core build",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "pretypecheck": "pnpm --filter @loci/core build",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "build:mac": "pnpm build && electron-builder --mac --publish never",
    "build:linux": "pnpm build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@loci/core": "workspace:*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tanstack/react-router": "^1.170.18",
    "antd": "^6.5.2",
    "croner": "^10.0.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "electron-updater": "^6.3.9",
    "es-toolkit": "^1.50.0",
    "mdream": "^1.5.8",
    "node-html-parser": "^9.0.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "which": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^7.2.6"
  }
}
