{
  "name": "@loci/desktop",
  "version": "1.7.2",
  "private": true,
  "description": "Loci desktop application.",
  "author": "yliu <yangboses@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/bosens-China/loci",
  "desktopName": "com.loci.app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "build:mac": "pnpm build && electron-builder --mac --publish never",
    "build:linux": "pnpm build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "croner": "^10.0.1",
    "mdream": "^1.5.8",
    "node-html-parser": "^9.0.1",
    "which": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@loci/core": "workspace:*",
    "@loci/runtime": "workspace:*",
    "@loci/shared": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tanstack/react-router": "^1.170.18",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^5.1.1",
    "antd": "^6.5.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  }
}
