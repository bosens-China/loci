{
  "name": "@boses/cli",
  "version": "2.0.0",
  "description": "Local documentation CLI for fetching, searching and reading libraries with AI agents.",
  "author": "yliu",
  "license": "MIT",
  "homepage": "https://github.com/bosens-China/loci#readme",
  "bugs": {
    "url": "https://github.com/bosens-China/loci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/loci.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "loci",
    "ai-agents",
    "documentation",
    "knowledge-base",
    "local-first",
    "openapi",
    "web-crawling",
    "cli"
  ],
  "type": "module",
  "bin": {
    "loci": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/resources/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @loci/web build && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@crawlee/basic": "^3.18.2",
    "@crawlee/browser-pool": "^3.18.2",
    "commander": "^15.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdream": "^1.5.8",
    "node-html-parser": "^9.0.1",
    "playwright-core": "1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@loci/core": "workspace:*",
    "@loci/runtime": "workspace:*",
    "@loci/shared": "workspace:*",
    "@loci/web": "workspace:*",
    "@types/node": "^22.19.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
