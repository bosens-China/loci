{
  "name": "@loci/cli",
  "version": "1.1.0",
  "description": "面向终端用户的 Loci 本地文档知识库。",
  "type": "module",
  "bin": {
    "loci": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdream": "^1.5.8",
    "node-html-parser": "^9.0.1",
    "playwright-core": "1.62.0",
    "which": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@loci/core": "workspace:*",
    "@loci/shared": "workspace:*",
    "@types/node": "^22.19.1",
    "@types/which": "^3.0.4",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
