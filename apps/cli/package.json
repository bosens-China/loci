{
  "name": "@boses/cli",
  "version": "1.12.0",
  "description": "CLI and MCP server for Loci, a local-first documentation knowledge base for AI agents.",
  "author": "yliu",
  "license": "MIT",
  "homepage": "https://github.com/bosens-China/loci#readme",
  "bugs": {
    "url": "https://github.com/bosens-China/loci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/loci.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "loci",
    "ai-agents",
    "documentation",
    "knowledge-base",
    "local-first",
    "mcp",
    "model-context-protocol",
    "openapi",
    "web-crawling",
    "cli"
  ],
  "type": "module",
  "bin": {
    "loci": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/resources/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/core": "1.4.3",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdream": "^1.5.8",
    "node-html-parser": "^9.0.1",
    "playwright-core": "1.62.0",
    "which": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@loci/core": "workspace:*",
    "@loci/runtime": "workspace:*",
    "@loci/shared": "workspace:*",
    "@types/node": "^22.19.1",
    "@types/which": "^3.0.4",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
